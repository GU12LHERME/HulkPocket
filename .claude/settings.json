{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git merge main:*)",
      "Bash(git merge origin/main:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)"
    ]
  }
}
