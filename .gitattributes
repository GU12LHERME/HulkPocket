# Normalize text to LF in the repository regardless of core.autocrlf.
* text=auto

# Scripts executed on Linux runners, WSL, Termux or the device: always LF.
*.sh      text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.cmake   text eol=lf
CMakeLists.txt text eol=lf
.githooks/* text eol=lf

# Windows-only launchers keep CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary assets must never be diffed or normalized.
*.png     binary
*.jpg     binary
*.spv     binary
*.so      binary
*.apk     binary
*.zip     binary
